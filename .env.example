# humatter Leads — Environment (Beispiel)
#
#   cp .env.example .env
#
# NIEMALS echte Secrets/Zugangsdaten committen (CLAUDE.md Regel 5).
# Produktions-Secrets werden ausschließlich auf dem Server gesetzt.
#
# Grundsatz: KEINE Infrastruktur-, Server- oder DB-Werte im Code. Alles
# Deployment-Abhängige steht hier. compose.yaml und die Anwendung lesen
# ausschließlich aus der Umgebung.

# =========================================================================
# Container-/Build-Einstellungen (compose.yaml)
# =========================================================================
NODE_VERSION=22.20.0
# Host-Port, unter dem das Frontend lokal erreichbar ist (nur 127.0.0.1).
FRONTEND_PORT=3000
# Nur für compose.override.yaml (lokale Host-Entwicklung):
POSTGRES_PORT=5432
BACKEND_PORT=8080
ADMINER_PORT=8081

# =========================================================================
# PostgreSQL  (eigener Docker-Service, persistentes Volume)
# =========================================================================
POSTGRES_USER=leads
POSTGRES_PASSWORD=CHANGE_ME_local_dev_password
POSTGRES_DB=leads

# Verbindungs-URL des Backends zur DB.
#  - in Containern (compose):     Host = Service-Name "db"
#  - für `npm run dev` vom Host:   Host = localhost (compose.override nötig)
DATABASE_URL=postgres://leads:CHANGE_ME_local_dev_password@db:5432/leads
# DATABASE_URL=postgres://leads:CHANGE_ME_local_dev_password@localhost:5432/leads
DATABASE_SSL=disable          # disable | require | no-verify
DATABASE_POOL_MAX=10

# =========================================================================
# Backend  (apps/backend)
# =========================================================================
PORT=8080
TRUST_PROXY=true
# Öffentliche Origin des Frontends — für den CSRF-Origin-Check.
# Produktion: https://<deine-domain>
APP_ORIGIN=http://localhost:3000
# Leer lassen bei der Standard-Topologie (Frontend proxyt /api -> Backend).
# Nur für direkten Browser->Backend-Zugriff die Frontend-URL(s) eintragen.
CORS_ALLOWED_ORIGINS=

# --- Registrierung ---
# Nur E-Mail-Adressen dieser Domain(s) dürfen sich selbst registrieren
# (kommagetrennt).
ALLOWED_EMAIL_DOMAINS=mindsewn.de
# Diese E-Mail(s) erhalten bei der Registrierung die Rolle "admin"
# (kommagetrennt). Leer = niemand automatisch Admin.
ADMIN_EMAILS=

# --- Session ---
# >= 32 Zeichen Zufall.  openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_openssl_rand_base64_48
SESSION_IDLE_TTL_MINUTES=60
SESSION_ABSOLUTE_TTL_HOURS=12
SESSION_COOKIE_NAME=hl_session
# auto = Secure-Flag an, sobald NODE_ENV=production. Sonst true|false.
SESSION_COOKIE_SECURE=auto

# Uploads / Objektspeicher (Phase 2) — Visitenkarten-Fotos/Scans
UPLOAD_DRIVER=local           # local | s3 (s3 noch nicht implementiert)
UPLOAD_LOCAL_DIR=./.data/uploads
UPLOAD_MAX_BYTES=10485760
# Ohne AV-Scanner: auto = außerhalb Produktion sofort "clean",
# in Produktion "pending" (manuelle Freigabe). true | false erzwingen.
UPLOAD_AUTO_APPROVE=auto
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# E-Mail / Passwort-Reset (Phase 2)
# log = Reset-Link landet im Log (kein Versand); smtp = noch nicht implementiert
MAIL_DRIVER=log
PASSWORD_RESET_TTL_MINUTES=60
# SMTP_HOST=
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=humatter Leads <no-reply@example.invalid>

# Rate Limiting
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# Retention / Cleanup (Tage) — siehe docs/retention.md
EXPORT_RETENTION_DAYS=7
SYNC_RECEIPT_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365

# Seed: in Produktion muss dies "true" sein, damit `db:seed` läuft.
SEED_ALLOW=false

# =========================================================================
# Frontend  (apps/frontend)
# =========================================================================
# Interne Backend-URL. In compose.yaml fest auf http://backend:8080 gesetzt;
# hier nur für `npm run dev` vom Host relevant.
BACKEND_INTERNAL_URL=http://localhost:8080
# Öffentlich (an den Browser ausgeliefert — nur unkritische Werte!)
NEXT_PUBLIC_APP_NAME=humatter Leads
